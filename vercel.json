{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/(.*\\.(?:css|js|png|jpg|jpeg|svg|ico|webp|gif|ttf|woff|woff2))",
      "dest": "/frontend/$1"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/pembayaran",
      "dest": "/frontend/pembayaran.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/verifikasi",
      "dest": "/frontend/verifikasi.html"
    },
    {
      "src": "/tinjau",
      "dest": "/frontend/tinjau.html"
    },
    {
      "src": "/pengguna",
      "dest": "/frontend/pengguna.html"
    },
    {
      "src": "/kategori",
      "dest": "/frontend/kategori.html"
    },
    {
      "src": "/tambah-kategori",
      "dest": "/frontend/tambah-kategori.html"
    },
    {
      "src": "/pelaporan",
      "dest": "/frontend/laporan.html"
    },
    {
      "src": "/laporan",
      "dest": "/frontend/laporan.html"
    },
    {
      "src": "/detail-laporan",
      "dest": "/frontend/detail-laporan.html"
    },
    {
      "src": "/akun",
      "dest": "/frontend/akun.html"
    },
    {
      "src": "/pengaturan",
      "dest": "/frontend/coming-soon.html"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
