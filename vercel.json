{
    "builds": [
        {
            "src": "backend/main.go",
            "use": "@vercel/go"
        },
        {
            "src": "frontend/**",
            "use": "@vercel/static"
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/main.go"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ]
}
