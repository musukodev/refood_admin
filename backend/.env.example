# Konfigurasi Server
PORT=8080
BASE_URL=http://localhost:8080

# Kredensial Duitku Sandbox (dapatkan dari Dashboard Duitku)
MERCHANT_CODE=D12345
API_KEY=your_sandbox_api_key_here
ENVIRONMENT=SANDBOX

# Fitur simulasi pembayaran lokal tanpa callback/ngrok (true/false)
ENABLE_PAYMENT_SIMULATION=true

# Database PostgreSQL (Supabase / Neon / Local PostgreSQL)
# Kosongkan jika ingin fallback ke in-memory store
DB_HOST=db.xxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=postgres
DB_SSLMODE=require
